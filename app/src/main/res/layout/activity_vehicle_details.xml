<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/linearlayoutvehicle"
    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:background="#F89427"
        android:orientation="horizontal">

        <Button
            android:id="@+id/vehicledetailsBackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:text="do"
            android:background="@android:color/transparent"
            android:drawableLeft="@drawable/baseline_arrow_back_black"
            android:gravity="center_vertical" />

        <TextView

            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="180px"
            android:background="#F89427"
            android:fontFamily="@font/archivo_bold"

            android:gravity="center"
            android:text="Vehicle Details"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="24sp" />


    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="30dp"
        android:background="@drawable/border"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:fontFamily="@font/archivo_medium"
            android:paddingTop="10dp"
            android:text="Upload Registration \n Certificate of the Vehicle"
            android:textAlignment="center"
            android:textColor="#101010" />

        <Button
            android:id="@+id/Upploadbutton"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:drawableLeft="@drawable/camera"
            android:textAlignment="center"
            android:backgroundTint="@color/orange"
            android:layout_gravity="center"
            android:text="Upload Image" />
    </LinearLayout>


    <Button
        android:id="@+id/submit_vehicle_button"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="300dp"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:paddingTop="16dp"
        android:text="Submit"
        android:paddingHorizontal="8dp"
        android:paddingBottom="12dp"
        android:backgroundTint="@color/orange"
        android:layout_gravity="center"/>

</LinearLayout>
