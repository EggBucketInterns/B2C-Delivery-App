<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="25dp"
        android:background="@color/white">

        <!-- Back button -->
        <ImageView
            android:id="@+id/aadharBackButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="center"
            android:src="@drawable/baseline_arrow_back_black"
            android:layout_gravity="start|center_vertical"
            app:tint="@color/black" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Edit Profile"
            android:textColor="@android:color/black"
            android:textSize="23sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- First Name Input -->
    <EditText
        android:id="@+id/edt_first_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="First Name"
        android:layout_margin="20dp"
        android:drawableStart="@drawable/person_edit"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3838"
        android:padding="12dp"
        android:inputType="textPersonName"
        android:background="@drawable/edt_background" />

    <!-- Last Name Input -->
    <EditText
        android:id="@+id/edt_last_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Last Name"
        android:layout_margin="20dp"
        android:drawableStart="@drawable/person_edit"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3838"
        android:padding="12dp"
        android:inputType="textPersonName"
        android:background="@drawable/edt_background" />

    <!-- Phone Number -->
    <EditText
        android:id="@+id/edt_phone_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Phone Number"
        android:layout_margin="20dp"
        android:drawableStart="@drawable/baseline_phone_24"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3838"
        android:padding="12dp"
        android:inputType="phone"
        android:background="@drawable/edt_background" />

    <!-- Email -->
    <EditText
        android:id="@+id/edt_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:layout_margin="20dp"
        android:drawableStart="@drawable/baseline_email_24"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3838"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        android:background="@drawable/edt_background" />

    <!-- Driving Licence -->
    <EditText
        android:id="@+id/edt_driving_licence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Driving Licence Number"
        android:layout_margin="20dp"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3838"
        android:padding="12dp"
        android:inputType="text"
        android:background="@drawable/edt_background" />

    <!-- Aadhaar Number -->
    <EditText
        android:id="@+id/edt_aadhaar_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Aadhaar Number"
        android:layout_margin="20dp"
        android:drawablePadding="10dp"
        android:drawableTint="#3A3838"
        android:padding="12dp"
        android:inputType="number"
        android:background="@drawable/edt_background" />

    <!-- Submit Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/sendOtpButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/edit_background_button"
        android:elevation="4dp"
        android:paddingVertical="12dp"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="20dp"/>


</LinearLayout>
