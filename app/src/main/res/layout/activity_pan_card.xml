<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:id="@+id/linearlayoutpan"
    tools:context=".PanCard">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Section -->
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:background="#F89427"
            android:orientation="horizontal">

            <Button
                android:id="@+id/panBackBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="20dp"
                android:background="@android:color/transparent"
                android:text=""
                android:drawableLeft="@drawable/baseline_arrow_back_black" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F89427"
                android:fontFamily="@font/archivo_bold"
                android:gravity="center"
                android:text="PAN Card Details"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- Instruction Section -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:fontFamily="@font/archivo_medium"
            android:text="Upload focused photo of your \nPAN Card for faster verification"
            android:textAlignment="center"
            android:textColor="#101010"
            android:textSize="18sp" />

        <!-- Front Side Upload Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="30dp"
            android:background="@drawable/border"
            android:padding="16dp">

            <TextView
                android:id="@+id/frontPanTextView"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:fontFamily="@font/archivo_medium"
                android:paddingTop="10dp"
                android:text="Upload front photo of your PAN\n card with your clear Name \n and Photo"
                android:textAlignment="center"
                android:textColor="#101010" />

            <Button
                android:id="@+id/front_pan_upload_button"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:drawableLeft="@drawable/camera"
                android:backgroundTint="@color/orange"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:text="Upload Image" />
            <ImageView
                android:id="@+id/imgFrontPan"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:adjustViewBounds="false"
                android:scaleType="centerCrop" />
        </LinearLayout>

        <!-- Back Side Upload Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="30dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/border"
            android:padding="16dp">

            <TextView
                android:id="@+id/back_pan_text_view"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:fontFamily="@font/archivo_medium"
                android:paddingTop="10dp"
                android:text="Upload back photo of your PAN\n card with your clear Name \n and Photo"
                android:textAlignment="center"
                android:textColor="#101010" />

            <Button
                android:id="@+id/back_pan_upload_button"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:drawableLeft="@drawable/camera"
                android:backgroundTint="@color/orange"
                android:textAlignment="center"
                android:layout_gravity="center"
                android:text="Upload Image" />
            <ImageView
                android:id="@+id/imgBackPan"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                android:adjustViewBounds="false"
                android:scaleType="centerCrop" />
        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/submit_pan_button"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="90dp"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:paddingTop="16dp"
            android:paddingHorizontal="8dp"
            android:paddingBottom="12dp"
            android:backgroundTint="@color/orange"
            android:layout_gravity="center"
            android:text="Submit" />
    </LinearLayout>

    <!-- Fullscreen Progress Bar -->
    <FrameLayout
        android:id="@+id/loaderContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80000000">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
