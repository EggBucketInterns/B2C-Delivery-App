<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/docs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Subtitle -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appThemeColor"
        android:paddingVertical="25dp">

        <ImageView
            android:id="@+id/backArrowDocs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="Back"
            android:onClick="onBackPressed"
            android:padding="8dp"
            android:scaleType="center"
            android:src="@drawable/baseline_arrow_back_black"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Personal Documents"
            android:textColor="@android:color/white"
            android:textSize="25sp"
            android:textStyle="normal" />
    </FrameLayout>

    <!-- Aadhar Card -->

    <TextView
        android:id="@+id/personalDocumentText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        android:fontFamily="@font/radio_canada"
        android:paddingHorizontal="20dp"
        android:text="Upload focused photos of below documents for faster verification."
        android:textColor="@color/black"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/linearAadharCard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="15dp"
        android:background="@drawable/rounded_background_with_border"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/buttonTextAadharDocument"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/istok_web"
            android:text="Aadhar Card"
            android:textColor="@android:color/black"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/buttonIconAadharDocument"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Default Arrow Icon"
            android:src="@drawable/img_2" />

    </LinearLayout>

    <!-- PAN Card -->

    <LinearLayout
        android:id="@+id/linearPANCard"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_background_with_border"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/buttonTextPANCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/istok_web"
            android:text="PAN Card"
            android:textColor="@android:color/black"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/buttonIconPANCard"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Default Arrow Icon"
            android:src="@drawable/img_2" />

    </LinearLayout>

    <!-- Driving License -->

    <LinearLayout
        android:id="@+id/linearDrivingLicense"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/rounded_background_with_border"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/buttonTextDrivingLicense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/istok_web"
            android:text="Driving License"
            android:textColor="@android:color/black"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/buttonIconDrivingLicense"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Default Arrow Icon"
            android:src="@drawable/img_2" />

    </LinearLayout>

    <!-- Submit Button -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Other views go here -->

        <Button
            android:id="@+id/submitButtonPersonalDoc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="15dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/orange"
            android:fontFamily="@font/istok_web_bold"
            android:gravity="center"
            android:text="Submit"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

    </RelativeLayout>


</LinearLayout>
