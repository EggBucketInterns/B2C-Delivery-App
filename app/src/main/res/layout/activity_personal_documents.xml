<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/personalDocuments"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/egg_bucket_doc"
    tools:context=".PersonalDocuments">

    <TextView
        android:id="@+id/titleWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="55dp"
        android:fontFamily="@font/quicksand_bold"
        android:text="Welcome to Egg Bucket. "
        android:textColor="@color/white"
        android:textSize="23sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/radio_canada_medium"
        android:text="Just a few steps to complete and then you can start earning with Us"
        android:textColor="#FDFCFC"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/titleWelcome"
        app:layout_constraintTop_toBottomOf="@+id/titleWelcome" />

    <TextView
        android:id="@+id/pendingDocuments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="60dp"
        android:paddingStart="15dp"
        android:paddingTop="15dp"
        android:fontFamily="@font/istok_web_bold"
        android:text="Pending Documents"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/welcomeText" />

    <!-- Pending Documents Group -->
    <LinearLayout
        android:paddingHorizontal="15dp"
        android:id="@+id/pendingDocumentsGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pendingDocuments">

        <LinearLayout
            android:id="@+id/linearPersonalDocuments"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_background_with_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/buttonTextPersonalDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/istok_web"
                android:text="Personal Documents"
                android:textColor="@android:color/black"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/buttonIconPersonalDocuments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Arrow Icon"
                android:src="@drawable/img_2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearVehicleDocuments"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_background_with_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/buttonTextVehicleDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/istok_web"
                android:text="Vehicle Documents"
                android:textColor="@android:color/black"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/buttonIconVehicleDocuments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Arrow Icon"
                android:src="@drawable/img_2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearBankDocuments"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_background_with_border"
            android:clickable="true"

            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/buttonTextBankDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/istok_web"
                android:text="Bank Account Details"
                android:textColor="@android:color/black"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/buttonIconBankDocuments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Arrow Icon"
                android:src="@drawable/img_2" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/linearPassbookDocuments"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_background_with_border"
            android:clickable="true"

            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/buttonTextPassbookDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/istok_web"
                android:text="Passbook"
                android:textColor="@android:color/black"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/buttonIconPassbookDocuments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Arrow Icon"
                android:src="@drawable/img_2" />
        </LinearLayout>

    </LinearLayout>

    <!-- Completed Documents Group -->
    <TextView
        android:id="@+id/completedDocuments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/istok_web_bold"
        android:text="Completed Documents"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pendingDocumentsGroup" />

    <LinearLayout
        android:paddingHorizontal="15dp"
        android:id="@+id/completedDocumentsGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/completedDocuments">

        <LinearLayout
            android:id="@+id/linearPersonalInformation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/rounded_background_with_border"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/buttonTextPersonalInformation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/istok_web"
                android:text="Personal Information"
                android:textColor="@android:color/black"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/buttonIconPersonalInformation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Arrow Icon"
                android:src="@drawable/img_2" />
        </LinearLayout>

        <!-- Add more completed documents items here if needed -->

    </LinearLayout>

    <Button
        android:id="@+id/submitButtonDocs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="60dp"
        android:backgroundTint="@color/orange"
        android:fontFamily="@font/istok_web_bold"
        android:gravity="center"
        android:padding="12dp"
        android:text="Submit"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/completedDocumentsGroup" />

</androidx.constraintlayout.widget.ConstraintLayout>
