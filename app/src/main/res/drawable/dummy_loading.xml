<!-- res/drawable/dummy_loading.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transparent background for visibility -->
    <item
        android:id="@android:id/background"
        android:drawable="@android:color/transparent" /> <!-- Transparent background to ensure text visibility -->

    <!-- Skeleton effect (slightly darker grey) -->
    <item>
        <shape
            android:shape="rectangle">
            <solid android:color="@android:color/darker_gray" /> <!-- Slightly darker grey color for skeleton -->

            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="8dp"
                android:bottom="8dp" /> <!-- Padding to adjust the appearance -->
        </shape>
    </item>

</layer-list>
